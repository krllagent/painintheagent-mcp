{
  "name": "painintheagent-mcp",
  "version": "0.3.1",
  "type": "module",
  "description": "MCP client for the Pain in the Agent text tools: watermark removal, humanizing and AI detection",
  "license": "MIT",
  "author": "Kirill Balakhonov",
  "repository": "github:krllagent/painintheagent-mcp",
  "homepage": "https://painintheagent.com/integrations/",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "painintheagent-mcp": "dist/index.cjs"
  },
